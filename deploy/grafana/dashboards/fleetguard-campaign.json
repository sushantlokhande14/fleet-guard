{
  "uid": "fleetguard-campaign",
  "title": "Fleet Guard / Build comparison",
  "tags": [
    "fleetguard"
  ],
  "description": "One campaign: baseline vs candidate KPIs, failures by category and family, top clusters.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Verdict",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT upper(verdict->>'status') AS verdict FROM campaigns WHERE id = $campaign",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "PASS": {
                  "color": "green"
                },
                "REGRESSION": {
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failing scenarios",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT count(*) AS failures FROM failures WHERE campaign_id = $campaign",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Drives",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT count(*) AS drives FROM drives WHERE campaign_id = $campaign",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Simulation rate",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT drives_per_second FROM campaigns WHERE id = $campaign",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Baseline vs candidate",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT role, build, drives, completed, disengaged, collisions, timeouts,\n               round(km::numeric, 1) AS km,\n               round(disengagements_per_1000km::numeric, 2) AS \"dis/1000km\",\n               round(recall::numeric, 4) AS recall, round(precision::numeric, 4) AS precision,\n               round(planner_p99_p99_ms::numeric, 1) AS \"planner p99 (ms)\",\n               deadline_misses AS \"deadline misses\",\n               round(cte_p95_mean::numeric, 3) AS \"cte p95 (m)\",\n               round(steer_reversal_rate::numeric, 3) AS \"steer rev/s\",\n               round(accel_reversal_rate::numeric, 3) AS \"accel rev/s\"\n          FROM campaign_role_metrics WHERE campaign_id = $campaign ORDER BY role",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Failures by category",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT category, count(*) AS failures FROM failures WHERE campaign_id = $campaign\n         GROUP BY category ORDER BY failures DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "category"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Failures by family",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT s.family, count(*) AS failures FROM failures f JOIN scenarios s ON s.id = f.scenario_id\n         WHERE f.campaign_id = $campaign GROUP BY s.family ORDER BY failures DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "family"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top clusters",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT signature, count(*) AS failures, max(severity) AS severity,\n               round(avg(score)::numeric, 2) AS \"mean score\"\n          FROM failures WHERE campaign_id = $campaign\n         GROUP BY signature ORDER BY failures DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Per family",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT family, role, drives, failed, collisions, round(recall::numeric, 4) AS recall,\n               round(planner_p99_p99_ms::numeric, 1) AS \"planner p99\",\n               round(steer_reversal_rate::numeric, 3) AS \"steer rev/s\"\n          FROM campaign_family_metrics WHERE campaign_id = $campaign ORDER BY family, role",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Strongest failures",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT f.id, f.scenario_id, f.category, f.severity, round(f.score::numeric, 2) AS score,\n               round(f.first_t::numeric, 1) AS \"first at (s)\", array_to_string(f.secondary, ', ') AS also,\n               f.repro_verified AS reproduced\n          FROM failures f WHERE f.campaign_id = $campaign ORDER BY f.severity DESC, f.score DESC LIMIT 25",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "campaign",
        "label": "Campaign",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "fleetdb"
        },
        "query": "SELECT id AS __value, '#' || id || '  ' || name AS __text FROM campaigns WHERE status = 'done' ORDER BY id DESC",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
