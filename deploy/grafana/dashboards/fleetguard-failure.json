  "templating": {
    "list": [
      {
        "name": "campaign",
        "label": "Campaign",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "fleetdb"
        },
        "query": "SELECT id AS __value, '#' || id || '  ' || name AS __text FROM campaigns WHERE status = 'done' ORDER BY id DESC",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "failure",
        "label": "Failure",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "fleetdb"
        },
        "query": "SELECT f.id AS __value, f.scenario_id || '  ' || f.category AS __text FROM failures f JOIN pairs p ON p.campaign_id = f.campaign_id AND p.scenario_id = f.scenario_id WHERE f.campaign_id = $campaign AND EXISTS (SELECT 1 FROM telemetry_frames t WHERE t.drive_id = p.candidate_drive) ORDER BY f.severity DESC, f.score DESC",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
