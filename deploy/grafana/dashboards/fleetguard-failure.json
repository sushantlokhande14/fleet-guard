{
  "uid": "fleetguard-failure",
  "title": "Fleet Guard / Failure telemetry",
  "tags": [
    "fleetguard"
  ],
  "description": "10 Hz telemetry of one failing scenario, baseline against candidate on the same clock.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Failure",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT f.scenario_id, f.category, f.signature, f.severity, round(f.first_t::numeric, 1) AS \"first at (s)\",\n               array_to_string(f.secondary, ', ') AS also, f.evidence::text AS evidence\n          FROM failures f WHERE f.id = $failure",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "trend",
      "title": "Speed",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fleetdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fleetdb"
          },
          "rawSql": "SELECT t.t AS \"time (s)\",\n               max(t.v) FILTER (WHERE d.role = 'baseline')  AS baseline,\n               max(t.v) FILTER (WHERE d.role = 'candidate') AS candidate\n          FROM failures f\n          JOIN pairs p ON p.campaign_id = f.campaign_id AND p.scenario_id = f.scenario_id\n          JOIN drives d ON d.id IN (p.baseline_drive, p.candidate_drive)\n          JOIN telemetry_frames t ON t.drive_id = d.id\n         WHERE f.id = $failure\n         GROUP BY t.t ORDER BY t.t",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "candidate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "time (s)"
      }
    },
